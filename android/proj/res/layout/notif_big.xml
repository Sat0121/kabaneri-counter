<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/mumei" android:textStyle="bold" android:textSize="15sp" android:text="無名" />
        <TextView android:id="@+id/m_pts" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="15sp" android:text="0pt" />
        <TextView android:id="@+id/m_high" android:layout_width="wrap_content" android:paddingLeft="10dp" android:paddingRight="10dp" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="高確" />
        <TextView android:id="@+id/m_enter" android:layout_width="wrap_content" android:paddingLeft="10dp" android:paddingRight="10dp" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="CZ突入" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:id="@+id/m_normal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="通常" />
        <TextView android:id="@+id/m_unknown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="不明" />
        <TextView android:id="@+id/m_flash" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="発光" />
        <TextView android:id="@+id/m_combo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="複合" />
        <TextView android:id="@+id/m_allstar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="オール" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ikoma" android:textStyle="bold" android:textSize="15sp" android:text="生駒" />
        <TextView android:id="@+id/i_pts" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="15sp" android:text="0pt" />
        <TextView android:id="@+id/i_high" android:layout_width="wrap_content" android:paddingLeft="10dp" android:paddingRight="10dp" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="高確" />
        <TextView android:id="@+id/i_enter" android:layout_width="wrap_content" android:paddingLeft="10dp" android:paddingRight="10dp" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="CZ突入" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:id="@+id/i_normal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="通常" />
        <TextView android:id="@+id/i_unknown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="不明" />
        <TextView android:id="@+id/i_flash" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="発光" />
        <TextView android:id="@+id/i_combo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="複合" />
        <TextView android:id="@+id/i_allstar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="オール" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <TextView android:id="@+id/undo" android:layout_width="wrap_content" android:paddingLeft="10dp" android:paddingRight="10dp" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="取り消す" />
        <TextView android:id="@+id/undo_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" android:maxLines="2" android:ellipsize="end" android:text="" />
        <TextView android:id="@+id/close" android:layout_width="wrap_content" android:paddingLeft="10dp" android:paddingRight="10dp" android:layout_height="40dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/nb_btn" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="12.5sp" android:maxLines="2" android:text="閉じる" />
    </LinearLayout>
</LinearLayout>
